    <p>✔ Accurate material quantities</p>
    <p>✔ Cost-saving insights</p>
  </div>
</div>

<!-- CASE STUDY -->
<div class="container">
  <h2>Real Case Study</h2>
  <div class="card">
    <p>1800 sqft house (Planning stage)</p>
    <p>Steel saved: ₹52,500</p>
    <p>Concrete saved: ₹72,000</p>
    <p>Hidden cost removed: ₹1,10,000</p>
    <p class="highlight">Total Saved: ₹2,34,500</p>
  </div>
</div>

<!-- PRICING -->
<div class="container">
