<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dream Ladders</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {font-family: Arial; margin:0; background:#f5f7fa;}
    .container {padding:40px 20px; max-width:1000px; margin:auto;}
    h1,h2 {color:#111;}
    p {color:#444;}
    .hero {text-align:center; background:#fff; padding:60px 20px;}
    .btn {
      display:inline-block;
      background:#007bff;
      color:#fff;
      padding:12px 20px;
      text-decoration:none;
      border-radius:6px;
      margin-top:15px;
    }
    .card {
      background:#fff;
      padding:20px;
      margin:15px 0;
      border-radius:10px;
      box-shadow:0 2px 8px rgba(0,0,0,0.1);
    }
    .pricing {display:flex; flex-wrap:wrap; gap:15px;}
    .price-box {
      flex:1;
      background:#fff;
      padding:20px;
      border-radius:10px;
      text-align:center;
      box-shadow:0 2px 8px rgba(0,0,0,0.1);
    }
    .highlight {color:green; font-weight:bold;}
    .loss {color:red; font-weight:bold;}
  </style>
</head>

<body>

<!-- HERO -->
<section class="hero">
  <h1>Avoid ₹5–10 Lakhs Loss in Your House Construction</h1>
  <p>AI + Civil Engineer Verified Estimation for Your Dream Home</p>
  <a class="btn" href="https://wa.me/91XXXXXXXXXX">Get My Estimate</a>
</section>

<!-- PROBLEM -->
<div class="container">
  <h2>Most Homeowners Lose Money Before Construction Starts</h2>
  <div class="card">
    <p>❌ No proper cost estimation</p>
    <p>❌ Contractor guesswork</p>
    <p>❌ No material clarity</p>
