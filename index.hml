  <div class="pricing">
    
    <div class="price-box">
      <h3>Basic</h3>
      <p>₹1,999</p>
      <p>AI Estimate</p>
    </div>

    <div class="price-box">
      <h3>Standard ⭐</h3>
      <p>₹4,999</p>
      <p>AI + Engineer Verified</p>
      <p>Consultation</p>
