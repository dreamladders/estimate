    <div class="price-box">
      <h3>Premium</h3>
      <p>₹14,999</p>
      <p>Full Planning Guidance</p>
      <p>Cost Optimization</p>
    </div>

  </div>
</div>

<!-- TRUST -->
<div class="container">
  <h2>Why Choose Us</h2>
  <div class="card">
    <p>✔ Civil Engineer Verified</p>
    <p>✔ Transparent Calculations</p>
    <p>✔ Built for Indian Homeowners</p>
  </div>
</div>

<!-- CTA -->
<section class="hero">
  <h2>Don’t Start Construction Blindly</h2>
  <p>One mistake can cost lakhs.</p>
  <a class="btn" href="https://wa.me/917093218658">Get My Estimate</a>
